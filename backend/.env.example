# Node runtime mode.
NODE_ENV=production
# HTTP port for the API.
PORT=4000
# File path for the local SQLite database.
DATABASE_PATH=./data/bookmyshow.db
# JWT signing secret; supply a real secret only through private runtime configuration.
JWT_SECRET=<required-secret>
# JWT issuer claim.
JWT_ISSUER=bookmyshow-replica
# Allowed browser origin for local development.
CORS_ORIGIN=http://localhost:3000
